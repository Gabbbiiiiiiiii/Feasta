# Non-secret redirect configuration for PayMongo Checkout Sessions.
PAYMENT_SUCCESS_URL=https://feasta-web.vercel.app/customer/payments?payment=success
PAYMENT_CANCEL_URL=https://feasta-web.vercel.app/customer/payments?payment=cancelled
# Payment gateway mode: "paymongo" (default) or "sandbox_mock" for simulated checkout & refunds.
PAYMENT_GATEWAY_MODE=paymongo

# Store credentials with Firebase Secret Manager; never put values here:
# firebase functions:secrets:set PAYMONGO_SECRET_KEY
# firebase functions:secrets:set PAYMONGO_WEBHOOK_SECRET
# firebase functions:secrets:set GOOGLE_MAPS_API_KEY
