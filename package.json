{
  "name": "feasta-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:coverage": "node scripts/verify-phase4-coverage.mjs",
    "design-system:coverage": "node scripts/verify-phase5-coverage.mjs",
    "flutter:security:test": "node scripts/verify-flutter-security.mjs",
    "admin:provision": "node --experimental-strip-types scripts/provision-admin.ts",
    "emulator:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-emulators.ps1",
    "emulator:seed": "node --experimental-strip-types scripts/seed-emulators.ts",
    "emulator:fixtures:clear": "node --experimental-strip-types scripts/clear-auth-emulator-fixtures.ts",
    "emulator:export": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-emulators.ps1",
    "emulator:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-emulators.ps1",
    "emulator:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-emulator-acceptance.ps1 -Suite rules",
    "emulator:tooling:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-emulator-acceptance.ps1 -Suite tooling",
    "emulator:hosting:test": "firebase emulators:exec --config firebase.hosting.test.json --project demo-feasta-phase3 --only functions,hosting \"node scripts/verify-hosting.mjs\"",
    "emulator:auth-web:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-emulator-acceptance.ps1 -Suite auth-web",
    "emulator:provider-workflow:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-emulator-acceptance.ps1 -Suite provider",
    "emulator:payment:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-emulator-acceptance.ps1 -Suite payment",
    "emulator:roundtrip:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-emulator-roundtrip.ps1",
    "phase3:verify": "pnpm security:secrets && pnpm --dir packages/shared-types build && pnpm --dir functions build && pnpm --dir functions lint && pnpm --dir apps/web lint && pnpm --dir apps/web typecheck && pnpm --dir apps/web test:security && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-flutter-phase3.ps1 && pnpm --dir functions test && pnpm emulator:test && pnpm emulator:tooling:test && pnpm emulator:auth-web:test && pnpm emulator:provider-workflow:test && pnpm emulator:payment:test && pnpm emulator:roundtrip:test && pnpm emulator:hosting:test",
    "phase4:local": "pnpm security:coverage && pnpm flutter:security:test",
    "phase4:verify": "pnpm phase4:local && pnpm phase3:verify",
    "phase5:flutter": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-flutter-phase5.ps1",
    "phase5:verify": "node scripts/verify-phase5.mjs",
    "phase6:coverage": "node scripts/verify-phase6-coverage.mjs",
    "phase6:verify": "node scripts/verify-phase6.mjs",
    "phase7:coverage": "node scripts/verify-phase7-coverage.mjs",
    "phase7:verify": "node scripts/verify-phase7.mjs"
  },
  "devDependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.24.0"
  }
}
